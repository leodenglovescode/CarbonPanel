# Local-development sentinel. Secure/TLS deployments reject this value and
# require a unique secret of at least 32 characters.
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
TOTP_SESSION_EXPIRE_MINUTES=5

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Local HTTP defaults. Production must use HTTPS and set COOKIE_SECURE=true.
COOKIE_SECURE=false
# Set to the served PEM certificate to bind self-signed Android pairing by QR.
# TLS_CERT_FILE=/path/to/cert.pem

DATABASE_URL=sqlite+aiosqlite:///./carbonpanel.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

METRICS_INTERVAL_SECONDS=2.0
PROCESS_LIMIT=25
