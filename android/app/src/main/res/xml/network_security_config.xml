<?xml version="1.0" encoding="utf-8"?>
<!-- Self-signed TLS is accepted only when its SHA-256 fingerprint arrived in
     the pairing QR and was installed before the first request. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
