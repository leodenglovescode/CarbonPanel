<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the widget picker.

  Glance renders at runtime, so the picker has nothing to show until the widget
  is placed — it fell back to a bare app icon, which is why the widget looked
  like an afterthought before it was even added. This is a plain layout that
  approximates the real thing: four rings and a throughput line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_title"
        android:textColor="@color/widget_preview_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_preview_ring"
            android:contentDescription="@string/metric_cpu" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_preview_ring"
            android:contentDescription="@string/metric_ram" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_preview_ring"
            android:contentDescription="@string/metric_gpu" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/widget_preview_ring"
            android:contentDescription="@string/metric_disk" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_preview_row"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:text="@string/widget_preview_network"
        android:textColor="@color/widget_preview_fg"
        android:textSize="12sp"
        android:fontFamily="monospace" />
</LinearLayout>
